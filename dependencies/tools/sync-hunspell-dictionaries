#
# This script clones (or updates) a directory (hunspell_dictionaries) holding
# the latest hunspell dictionaries (and dic_delta files) from chromium, then
# builds two archives, core-dictionaries-<date>.zip and
# all-dictionaries-<date>.zip. To publish them, upload both to the
# dictionaries/ folder of the rstudio-buildtools S3 bucket (with public-read),
# then update the dates referenced by dependencies/common/install-dictionaries,
# dependencies/windows/install-dependencies.cmd, and
# src/cpp/session/modules/SessionSpelling.R.
#

set -e

# install dir
INSTALL_DIR=`pwd`

# get the latest dictionaries and switch to the dictionary directory
HUNSPELL_DICTIONARIES=hunspell_dictionaries
HUNSPELL_DICTIONARIES_REPO=https://chromium.googlesource.com/chromium/deps/hunspell_dictionaries
if [ -d "$HUNSPELL_DICTIONARIES" ]; then
   git -C "$HUNSPELL_DICTIONARIES" pull --ff-only
else
   git clone --depth 1 "$HUNSPELL_DICTIONARIES_REPO" "$HUNSPELL_DICTIONARIES"
fi
cd $HUNSPELL_DICTIONARIES

DICTIONARIES_VERSION=$(date +%Y-%m-%d)

# build the core archive
CORE_DICTIONARIES="core-dictionaries-${DICTIONARIES_VERSION}.zip"
rm -f $CORE_DICTIONARIES
ls | egrep '^(en_US|en_GB|en_CA|en_AU)\..*$' | zip -@ $CORE_DICTIONARIES

# build the universal archive
ALL_DICTIONARIES="all-dictionaries-${DICTIONARIES_VERSION}.zip"
rm -f $ALL_DICTIONARIES
ls | egrep '^(bg_BG|ca_ES|cs_CZ|da_DK|de_DE|de_DE_neu|el_GR|en_US|en_GB|en_CA|en_AU|es_ES|fr_FR|hr_HR|hu-HU|id_ID|it_IT|lt_LT|lv_LV|nb_NO|nl_NL|pl_PL|pt_BR|pt_PT|ro_RO|ru_RU|sh|sk_SK|sl_SI|sr|sv_SE|uk_UA|vi_VN)\..*$' | zip -@ $ALL_DICTIONARIES

# return to install dir
cd $INSTALL_DIR
