
<ui:UiBinder
   xmlns:ui="urn:ui:com.google.gwt.uibinder"
   xmlns:g="urn:import:com.google.gwt.user.client.ui"
   xmlns:c="urn:import:com.google.gwt.user.cellview.client">


   <ui:style>

   @external rstudio-themes-dark;
   @eval THEME_DARK_DIALOG_CONTROL_BACKGROUND org.rstudio.core.client.theme.ThemeColors.darkDialogControlBackground;
   @eval THEME_DARKGREY_BACKGROUND org.rstudio.core.client.theme.ThemeColors.darkGreyBackground;
   @eval THEME_DARKGREY_BORDER org.rstudio.core.client.theme.ThemeColors.darkGreyBorder;

   .headerLabel {
      margin-bottom: 12px;
   }

   .table {
      width: 500px;
      height: 400px;
      border: 1px solid #BBB;
      background-color: white;
   }

   .rstudio-themes-dark .table {
      background-color: THEME_DARK_DIALOG_CONTROL_BACKGROUND;
      border-color: THEME_DARKGREY_BORDER;
      color: #eee;
      color-scheme: dark;
   }

   .rstudio-themes-dark .table th {
      background-color: THEME_DARKGREY_BACKGROUND;
      border-color: THEME_DARKGREY_BORDER;
      color: inherit;
   }

   .rstudio-themes-dark .table td {
      border-color: transparent;
   }

   .scrollPanel {
      }

   </ui:style>

   <g:VerticalPanel>
      <g:Label ui:field="headerLabel_" styleName="{style.headerLabel}"></g:Label>
      <g:ScrollPanel styleName="{style.scrollPanel}">
         <c:DataGrid ui:field="table_" styleName="{style.table}"/>
      </g:ScrollPanel>
   </g:VerticalPanel>

</ui:UiBinder> 
