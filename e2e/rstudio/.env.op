# OP secret references for the E2E suite. This file holds no secrets: each
# value is a pointer resolved at run time, either by load-secrets-action in CI
# (via OP_ENV_FILE) or locally by
# `op run --env-file=.env.op -- npx playwright test`.
#
# Resolved via a read-only OP service account scoped to a single vault.
# Changes here should be reviewed by the security team.

# Posit AI test account, used by the Playwright auth setup project to sign in.
POSIT_EMAIL="op://RStudio OSS GitHub Actions/Login/username"
POSIT_PASSWORD="op://RStudio OSS GitHub Actions/Login/password"
